{
    "manifest_version": 3,
    "name": "PromptNexus",
    "version": "1.0.0",
    "description": "Chrome extension for PromptNexus - Manage and optimize your prompts",
    "permissions": [
        "activeTab",
        "storage",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "action": {
        "default_title": "PromptNexus",
        "default_popup": "popup.html"
    }
}